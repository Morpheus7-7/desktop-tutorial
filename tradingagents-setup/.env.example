# ============================================================
#  TradingAgents — configurazione 100% LOCALE con Ollama
#  Copia questo file in ".env"  (cp .env.example .env)
#  Nessuna chiave a pagamento necessaria.
# ============================================================

# --- IA in locale (Ollama) ---
TRADINGAGENTS_LLM_PROVIDER=ollama
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Modelli Ollama da usare (devi averli scaricati con `ollama pull <nome>`).
# 'deep' = ragionamento profondo (più grande/lento), 'quick' = supporto veloce.
TRADINGAGENTS_DEEP_THINK_LLM=qwen2.5:14b
TRADINGAGENTS_QUICK_THINK_LLM=llama3.1

# Round di dibattito tra gli agenti (1 = veloce; valori alti = più accurato ma lento)
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Lingua dei report e della decisione
TRADINGAGENTS_OUTPUT_LANGUAGE=Italian

# --- Opzionale: dati macroeconomici (chiave gratuita) ---
# Richiedila qui: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# ============================================================
#  ALTERNATIVA CLOUD (a pagamento) — più qualità e velocità.
#  Scommenta e togli quella locale sopra se un giorno la vorrai.
# ============================================================
# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.5
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
# OPENAI_API_KEY=sk-...
#
# Oppure Anthropic (Claude):
# TRADINGAGENTS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
