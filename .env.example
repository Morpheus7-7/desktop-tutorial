# Copia questo file in ".env" e compila i valori reali.
# NON committare mai il file .env (è già in .gitignore).

# --- Credenziali account MetaTrader 5 ---
# Usa SEMPRE un account DEMO finché la strategia non è validata.
MT5_LOGIN=12345678
MT5_PASSWORD=la_tua_password
MT5_SERVER=NomeBroker-Demo
# Percorso del terminale MT5 (opzionale, se non nel path di default)
MT5_TERMINAL_PATH=

# --- LLM locale (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Sicurezza ---
# Deve valere "true" per poter operare su un conto REALE. Default: trading solo demo.
ALLOW_LIVE_TRADING=false
